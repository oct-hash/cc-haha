    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-reconciler": "^0.33.0",
    "semver": "^7.8.5",
    "shell-quote": "^1.9.0",
    "signal-exit": "^4.1.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^4.5.0",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "type-fest": "^5.7.0",
    "undici": "^8.5.0",
    "usehooks-ts": "^3.1.1",
    "vscode-jsonrpc": "9.0.0",
    "vscode-languageserver-types": "^3.18.0",
