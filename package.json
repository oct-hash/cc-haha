{
  "name": "claude-code-local",
  "version": "999.0.0-local",
  "private": true,
  "type": "module",
  "bin": {
    "claude-haha": "./bin/claude-haha"
  },
  "scripts": {
    "claude-haha": "bun run ./bin/claude-haha",
    "start": "bun run ./bin/claude-haha",
    "quality-gate": "bun run scripts/quality-gate/index.ts",
    "quality-gate:baseline": "bun run scripts/quality-gate/index.ts --mode baseline",
    "quality-gate:release": "bun run scripts/quality-gate/index.ts --mode release",
    "quality-gate:smoke": "bun run scripts/quality-gate/index.ts --only provider-smoke --allow-live",
    "quality-gate:policy": "bun run scripts/quality-gate/index.ts --only policy-checks",
    "quality-gate:setup-pre-push": "bun run scripts/quality-gate/setup-pre-push.ts",
    "test": "bun test --path-ignore-patterns \"**/REPL.handlers.test.*\"",
    "test:handlers": "bun test src/screens/__tests__/REPL.handlers.test.ts",
    "test:all": "bun run test ; bun run test:handlers",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "test:ci": "bun run test && bun run test:handlers",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:biome": "biome check . --max-diagnostics=200",
    "lint:biome:fix": "biome check --write .",
    "lint": "bun run lint:biome && bun run typecheck",
    "check": "bun run lint && bun run test:ci",
    "ci": "bun run check && bun run quality-gate --mode pr --json"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.61",
    "@anthropic-ai/sdk": "^0.106.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1075.0",
    "@commander-js/extra-typings": "^15.0.0",
    "@growthbook/growthbook": "^1.6.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "ajv": "^8.20.0",
    "asciichart": "^1.5.25",
    "auto-bind": "^5.0.1",
    "axios": "^1.18.1",
    "bidi-js": "^1.0.3",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cli-boxes": "^4.0.1",
    "code-excerpt": "^4.0.0",
    "diff": "^9.0.0",
    "emoji-regex": "^10.6.0",
    "env-paths": "^4.0.0",
    "execa": "^9.6.1",
    "figures": "^6.1.0",
    "fuse.js": "^7.4.2",
    "get-east-asian-width": "^1.6.0",
    "google-auth-library": "^10.9.0",
    "highlight.js": "^11.11.1",
    "https-proxy-agent": "^9.1.0",
    "ignore": "^7.0.5",
    "imapflow": "^1.5.0",
    "indent-string": "^5.0.0",
    "ink": "^7.1.0",
    "ink-testing-library": "^4.0.0",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.5.1",
    "mailparser": "^3.9.12",
    "marked": "^18.0.5",
    "p-map": "^7.0.4",
    "pdfjs-dist": "^6.1.200",
