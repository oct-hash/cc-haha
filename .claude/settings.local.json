  "hooks": {
    "PreToolUse": [
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "bash /d/claude-code-haha/.claude/hooks/workflow-enforcement/task-delete-enforce.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash(git commit *)",
        "hooks": [
          {
            "type": "command",
            "command": "bash /d/claude-code-haha/.claude/hooks/workflow-enforcement/pre-commit-gate.sh",
            "timeout": 300000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /d/claude-code-haha/.claude/hooks/workflow-enforcement/post-edit-remind.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash /d/claude-code-haha/.claude/hooks/workflow-enforcement/session-start-inject.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /d/claude-code-haha/.claude/hooks/workflow-enforcement/stop-gate.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "haha-plugins-local": {
